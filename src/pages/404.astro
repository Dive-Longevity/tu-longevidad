---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada">
  <section class="wrap nf">
    <span class="ghost" aria-hidden="true">404</span>
    <div class="front">
      <p class="t-kicker muted">Error 404</p>
      <h1 class="t-hook-l">Esta página no existe. El estudio, sí.</h1>
      <a class="btn btn-main" href="/">Volver a la portada</a>
    </div>
  </section>
</Base>
<style>
  .nf { position: relative; overflow: hidden; text-align: center; padding-block: clamp(96px, 16vw, 200px); }
  .nf .ghost { top: 50%; transform: translate(-50%, -50%); }
  .front { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 24px; }
  .front h1 { max-width: 16ch; }
</style>
