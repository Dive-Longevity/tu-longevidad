---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import SerieTag from '../../components/SerieTag.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import DatoClave from '../../components/DatoClave.astro';
import Protocolo from '../../components/Protocolo.astro';
import MitoODato from '../../components/MitoODato.astro';
import PreguntaConsulta from '../../components/PreguntaConsulta.astro';
import DiagramaHUD from '../../components/DiagramaHUD.astro';
import Veredicto from '../../components/Veredicto.astro';
import { getArticulos, readingTime } from '../../lib/articles';
import { DISCLAIMER, SITE, formatDate } from '../../lib/site';

export async function getStaticPaths() {
  const all = await getArticulos();
  return all.map((articulo) => ({ params: { slug: articulo.id }, props: { articulo, all } }));
}

const { articulo, all } = Astro.props;
const { data } = articulo;
const { Content, headings } = await render(articulo);
const capitulos = headings.filter((h) => h.depth === 2);
const relacionados = all.filter((a) => a.data.serie === data.serie && a.id !== articulo.id).slice(0, 3);
const masLeidos = relacionados.length < 3 ? all.filter((a) => a.id !== articulo.id && !relacionados.includes(a)).slice(0, 3 - relacionados.length) : [];
const minutos = readingTime(articulo);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.remate ? `${data.title} ${data.remate}` : data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  author: { '@type': 'Organization', name: data.author },
  publisher: { '@type': 'Organization', name: SITE.name },
  inLanguage: 'es',
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
  citation: data.fuentes.map((f) => f.url ?? f.label),
};
---
<Base title={data.title} description={data.description} image={data.image} type="article" publishedTime={data.pubDate} jsonLd={jsonLd}>
  {capitulos.length > 1 && (
    <div class="chapters" aria-hidden="true">
      <div class="wrap ch-in">
        {capitulos.map((c) => <a class="seg" href={`#${c.slug}`} data-target={c.slug} title={c.text}><i /></a>)}
      </div>
    </div>
  )}

  <article class="art">
    <header class="wrap art-head">
      <div class="art-meta enter">
        <SerieTag serie={data.serie} link />
        {data.formato && <span class="t-kicker muted">{data.formato}</span>}
      </div>
      <h1 class="t-hook-l enter enter-2">{data.title}{data.remate && <><br /><span class="muted">{data.remate}</span></>}</h1>
      <p class="t-lede art-lede enter enter-3">{data.description}</p>
      <p class="t-source enter enter-3">{data.author} · <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time> · {minutos} min de lectura{data.fuentes.length > 0 && <> · {data.fuentes.length} fuentes</>}</p>
    </header>

    <div class="wrap">
      <Photo class="art-photo" src={data.image} alt={data.imageAlt} settle eager />
    </div>

    <div class="wrap art-grid">
      {capitulos.length > 1 && (
        <aside class="toc" aria-label="En este artículo">
          <p class="t-kicker muted">En este artículo</p>
          <ol>{capitulos.map((c, i) => <li><a href={`#${c.slug}`} data-toc={c.slug}><span class="t-kicker">{String(i + 1).padStart(2, '0')}</span>{c.text}</a></li>)}</ol>
        </aside>
      )}
      <div class="prose">
        <Content components={{ DatoClave, Protocolo, MitoODato, PreguntaConsulta, DiagramaHUD, Veredicto }} />

        {data.fuentes.length > 0 && (
          <section class="fuentes" aria-labelledby="h-fuentes">
            <h2 id="h-fuentes">Fuentes</h2>
            <ol>
              {data.fuentes.map((f) => <li class="t-source">{f.url ? <a href={f.url} rel="noopener" target="_blank">{f.label}</a> : f.label}</li>)}
            </ol>
          </section>
        )}
        <p class="aviso t-source">{DISCLAIMER} Los datos se expresan como asociaciones observadas en estudios, no como promesas individuales. Si necesitas tratamiento, háblalo con tu médico.</p>
      </div>
    </div>
  </article>

  <section class="wrap rel" aria-labelledby="h-rel">
    <hr class="rule" />
    <div class="rel-head">
      <p class="t-kicker muted">Sigue leyendo</p>
      <h2 id="h-rel" class="t-title">De la misma serie</h2>
    </div>
    <div class="rel-grid">{[...relacionados, ...masLeidos].map((a) => <ArticleCard articulo={a} />)}</div>
  </section>
</Base>

<script>
  // BarraCapitulos: un tramo por capítulo; los hechos se llenan, el activo se llena con el scroll.
  const segs = [...document.querySelectorAll<HTMLAnchorElement>('.chapters .seg')];
  const tocs = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
  const heads = segs.map((s) => document.getElementById(s.dataset.target!)).filter(Boolean) as HTMLElement[];
  const end = document.querySelector('.fuentes') ?? document.querySelector('.aviso');
  if (heads.length) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const y = window.scrollY + window.innerHeight * 0.3;
      const tops = heads.map((h) => h.getBoundingClientRect().top + window.scrollY);
      const last = end ? end.getBoundingClientRect().top + window.scrollY : document.body.scrollHeight;
      let active = -1;
      tops.forEach((t, i) => {
        const next = tops[i + 1] ?? last;
        const p = Math.min(1, Math.max(0, (y - t) / (next - t)));
        (segs[i].firstElementChild as HTMLElement).style.transform = `scaleX(${p})`;
        if (y >= t) active = i;
      });
      tocs.forEach((a, i) => a.toggleAttribute('aria-current', i === active));
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>

<style>
  .chapters { position: sticky; top: 68px; z-index: 40; pointer-events: none; }
  .ch-in { display: flex; gap: 6px; padding-top: 10px; }
  .seg { flex: 1; height: 5px; border-radius: 999px; background: var(--line); overflow: hidden; pointer-events: auto; }
  .seg i { display: block; height: 100%; background: var(--ink); transform: scaleX(0); transform-origin: left; }
  @media (max-width: 980px) { .chapters { top: 108px; } }

  .art-head { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px; padding-top: clamp(48px, 7vw, 96px); padding-bottom: clamp(36px, 5vw, 56px); }
  .art-meta { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; justify-content: center; }
  .art-head h1 { max-width: 20ch; }
  .art-lede { max-width: 52ch; }
  :global(.art-photo) { aspect-ratio: 21 / 9; }
  @media (max-width: 640px) { :global(.art-photo) { aspect-ratio: 4 / 3; } }

  .art-grid { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: clamp(32px, 5vw, 80px); margin-top: clamp(40px, 6vw, 72px); }
  .art-grid > .prose:only-child { grid-column: 1 / -1; margin-inline: auto; }
  .toc { position: sticky; top: 110px; align-self: start; }
  .toc ol { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 4px; }
  .toc a { display: grid; grid-template-columns: 30px 1fr; gap: 6px; padding: 8px 0; font-size: 14px; line-height: 1.35; text-decoration: none; color: var(--ink-muted); transition: color var(--dur-quick) var(--ease-signature); }
  .toc a .t-kicker { font-size: 11px; padding-top: 3px; }
  .toc a:hover, .toc a[aria-current] { color: var(--ink); }
  @media (max-width: 980px) { .art-grid { grid-template-columns: 1fr; } .toc { display: none; } .prose { margin-inline: auto; } }

  .fuentes ol { padding-left: 1.6em; }
  .fuentes li { margin-top: .5em; font-size: 14px; }
  .aviso { margin-top: 2.4em !important; padding-top: 1.4em; border-top: 2px solid var(--line); }

  .rel { margin-top: clamp(72px, 9vw, 120px); }
  .rel-head { display: flex; flex-direction: column; gap: 12px; margin: 48px 0 36px; }
  .rel-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px 24px; }
  @media (max-width: 980px) { .rel-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .rel-grid { grid-template-columns: 1fr; } }
</style>
