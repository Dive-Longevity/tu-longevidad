---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticulos } from '../../lib/articles';
import { SERIES, SERIE_IDS } from '../../lib/site';
const articulos = await getArticulos();
---
<Base title="Todos los artículos" description="El archivo completo de Tú Longevidad: sueño, alimentación, movimiento, hábitos y análisis de productos.">
  <header class="wrap head">
    <p class="t-kicker muted">Archivo · {articulos.length} artículos</p>
    <h1 class="t-hook-l">Todo lo publicado</h1>
    <nav class="chips" aria-label="Filtrar por serie">
      {SERIE_IDS.map((id) => <a class="serie" data-serie={id} href={`/categoria/${SERIES[id].slug}`}>{SERIES[id].name}</a>)}
    </nav>
  </header>
  <div class="wrap grid">{articulos.map((a) => <ArticleCard articulo={a} />)}</div>
</Base>

<style>
  .head { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 20px; padding-block: clamp(56px, 8vw, 110px) clamp(40px, 6vw, 64px); }
  .chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 8px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 44px 28px; }
  @media (max-width: 980px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
</style>
