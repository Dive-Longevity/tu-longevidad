---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import SerieTag from '../../components/SerieTag.astro';
import { getArticulos } from '../../lib/articles';
import { SERIES, SERIE_IDS, type SerieId } from '../../lib/site';

export async function getStaticPaths() {
  const all = await getArticulos();
  return SERIE_IDS.map((id) => ({
    params: { serie: SERIES[id].slug },
    props: { id, articulos: all.filter((a) => a.data.serie === id) },
  }));
}
const { id, articulos } = Astro.props as { id: SerieId; articulos: Awaited<ReturnType<typeof getArticulos>> };
const s = SERIES[id];
---
<Base title={s.name} description={s.intro}>
  <header class="wrap cat-head">
    <span class="ghost" aria-hidden="true">{s.ghost}</span>
    <div class="cat-front">
      <SerieTag serie={id} />
      <p class="t-kicker muted">{s.kicker}</p>
      <h1 class="t-hook">{s.name}</h1>
      <p class="t-lede">{s.intro}</p>
    </div>
  </header>
  <nav class="wrap cat-nav" aria-label="Otras series">
    {SERIE_IDS.filter((x) => x !== id).map((x) => <a class="chip chip-opaque" href={`/categoria/${SERIES[x].slug}`}>{SERIES[x].name}</a>)}
  </nav>
  <section class="wrap">
    {articulos.length
      ? <div class="grid">{articulos.map((a, i) => <ArticleCard articulo={a} size={i === 0 ? 'l' : 'm'} />)}</div>
      : <p class="t-lede muted center">Pronto, el primer artículo de esta serie.</p>}
  </section>
</Base>

<style>
  .cat-head { position: relative; overflow: hidden; text-align: center; padding-block: clamp(64px, 10vw, 140px) clamp(40px, 6vw, 72px); }
  .cat-head .ghost { top: 50%; transform: translate(-50%, -50%); }
  .cat-front { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 20px; }
  .cat-front .t-lede { max-width: 48ch; }
  .cat-nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-bottom: clamp(40px, 6vw, 72px); }
  .chip-opaque:hover { background: var(--line); }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 44px 28px; }
  .grid > :global(.ac-l) { grid-column: span 2; grid-row: span 2; }
  @media (max-width: 980px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } .grid > :global(.ac-l) { grid-column: auto; grid-row: auto; } }
</style>
